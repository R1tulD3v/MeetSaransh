# Copy this file to `.env` and fill in your key.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
#
# Get a FREE key at https://console.groq.com/keys - no credit card required.
GROQ_API_KEY=

# Optional overrides (sensible defaults are used if left blank):
ASR_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b
EMBED_MODEL=BAAI/bge-small-en-v1.5

# The app runs WITHOUT a key using the bundled sample meeting (see README).
