# Copy this file to `.env` and fill in your key.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
#
# Every value below is optional except GROQ_API_KEY, and every one has a sane default,
# so an empty .env is a working configuration. The app runs WITHOUT a key using the
# bundled sample meeting (see README).

# ----------------------------------------------------------------------- provider
# Get a FREE key at https://console.groq.com/keys - no credit card required.
GROQ_API_KEY=

# Model overrides. Groq is OpenAI-compatible, so pointing GROQ_BASE_URL at another
# compatible provider is the whole of a provider swap.
ASR_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b
EMBED_MODEL=BAAI/bge-small-en-v1.5
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --------------------------------------------------------------------- environment
# "development" enables /docs and relaxes HSTS; "production" tightens both and
# refuses to start with a wildcard CORS policy.
ENVIRONMENT=development

# --------------------------------------------------------------------------- auth
# REQUIRED IN PRODUCTION. There is deliberately no default: a shipped default secret is
# a shipped forgery key. In development a random one is generated per process, which
# only means sessions end when you restart the server.
#   Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Short access token, long revocable refresh token.
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------ background jobs
# Transcription runs off the request thread. Few workers on purpose: each job is
# dominated by a network call, and the provider rate-limits before local CPU does.
JOB_WORKERS=2
# Per-user ceiling on queued/running jobs, so one account cannot fill the queue.
MAX_ACTIVE_JOBS_PER_USER=3

# ------------------------------------------------------------------- observability
LOG_LEVEL=INFO
# One JSON object per log line. Defaults to on in production, off in development.
# LOG_JSON=false
METRICS_ENABLED=true

# ------------------------------------------------------------------- rate limiting
# These endpoints call paid APIs, so they are capped per client per window.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD=5     # POST /meetings  - runs ASR + LLM, the most expensive call
RATE_LIMIT_CHAT=20      # POST /chat      - one LLM call
RATE_LIMIT_DEFAULT=120  # everything else - cheap reads
RATE_LIMIT_AUTH=10      # login/register - brute-force target, and each runs a slow KDF
# Only enable this when a proxy you control overwrites X-Forwarded-For. Otherwise a
# client can spoof the header and mint unlimited identities.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------- CORS
# Comma-separated allowlist. Empty means same-origin only, which is correct when this
# app serves its own frontend. Must not be "*" in production.
CORS_ORIGINS=

# ------------------------------------------------------------------------- storage
# Where the SQLite database and uploaded audio live. The container sets DATA_DIR=/data
# and mounts a volume there.
# DATA_DIR=./data

# --------------------------------------------------------------------------- tuning
# MAX_UPLOAD_BYTES=26214400   # 25 MB, matching the ASR provider's own per-file cap
# CHUNK_TARGET_WORDS=130      # must stay larger than CHUNK_OVERLAP_WORDS
# CHUNK_OVERLAP_WORDS=30
# RAG_TOP_K=6                 # excerpts fed to the LLM per question
# RAG_MIN_SCORE=0.50          # empirically tuned refusal threshold (see README)

# --- Query rewriting ---
# An LLM rewrites the question into retrieval vocabulary before searching. Ships ON:
# the harness measured recall@1 0.827 -> 0.981 and paraphrase recall@1 0.500 -> 1.000.
# Costs one extra LLM call (~1.6s median), which moves first-citation latency on the
# streaming endpoint from ~0.1s to ~1.7s. Set false for latency-sensitive deployments.
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_MAX_CHARS=400   # longer output means the model answered, not rewrote

# --- Reranking (a cross-encoder second stage) ---
# Ships OFF on evidence: the evaluation harness measured it making results slightly
# worse on a small corpus. Turn it on and re-run `python -m evaluation.run --rerank`
# against your own data before believing it helps.
# RERANK_ENABLED=false
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=20        # must be >= RAG_TOP_K
# HTTP_TIMEOUT_SECONDS=300
